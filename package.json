{
  "name": "draw2d",
  "productName": "drAW2D",
  "desktopName": "draw2d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "drAW2D — 2B geometri ve fonksiyon çizim uygulaması",
  "author": "mADEMatik <madematik@madematik.com>",
  "homepage": "https://www.madematik.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/200709078/drAW2D.git"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && node scripts/dev-electron.mjs",
    "electron": "npm run build && node scripts/start-electron.mjs",
    "test": "playwright test",
    "test:electron": "npm run build && node scripts/test-electron.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "mathjs": "15.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.madematik.draw2d",
    "productName": "drAW2D",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icons",
      "category": "Education;Math",
      "executableName": "draw2d",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "drAW2D",
          "Comment": "2B geometri ve fonksiyon çizimi"
        }
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "drAW2D"
    }
  }
}
